# Optional. With nothing set, the app runs in demo mode: a local database in
# .data/ with sample data, and a simulated wallet. `npm run setup` writes
# .env.local for the Mutinynet test wallet. Copy this file only to go further.

# --- Public URL (used in emails and share links)
APP_URL=http://localhost:3000

# --- Lightning wallet: Nostr Wallet Connect string from Alby Hub or any NWC wallet.
# Grant only: make_invoice, lookup_invoice, pay_invoice, get_balance, with a budget.
NWC_URL=
# Test network only: a sub-wallet standing in for the hospital's own wallet.
TEST_HOSPITAL_NWC_URL=
# Which chain that wallet is on: mainnet (default) or mutinynet (free test coins).
# The app refuses invoices from the other network, so this can't be set wrong silently.
LIGHTNING_NETWORK=mainnet
# Production refuses to start payments without a real wallet unless this is true.
ALLOW_DEMO_WALLET=false

# --- Database: any Postgres (Railway, Neon, Supabase...). Migrations run on start.
# Unset = the embedded local database (development only).
DATABASE_URL=
# The local database starts empty. true loads sample hospitals and campaigns
# (the automated tests use this).
SAMPLE_DATA=false

# --- Auth
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Hourly reserves cron: GET /api/cron/reserves with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# --- Email notifications (optional; logs to the console when unset)
RESEND_API_KEY=
EMAIL_FROM="Ireti <updates@your-domain.ng>"
