{
  "name": "ireti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:ledger": "LOCAL_DB=memory tsx --conditions=react-server scripts/smoke-ledger.ts",
    "typegen": "next typegen",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "hospital:add": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/add-hospital.ts",
    "db:reset": "rm -rf .data/ireti-db"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@getalby/bitcoin-connect-react": "^3.12.3",
    "@getalby/lightning-tools": "^10.0.0",
    "@getalby/sdk": "^9.0.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
